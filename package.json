{
  "name": "paloma",
  "description": "Paloma — a self-hosted photo manager inspired by Google Picasa.",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Oleksandr Rozhyk",
  "homepage": "https://github.com/rozhik/paloma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rozhik/paloma.git"
  },
  "bugs": {
    "url": "https://github.com/rozhik/paloma/issues"
  },
  "keywords": [
    "photo-manager",
    "picasa",
    "self-hosted",
    "photos"
  ],
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
