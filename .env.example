# Server
PORT=3001

# Client (Vite)
CLIENT_PORT=3000

# Data directories (relative paths resolve from the server working directory)
PALOMA_DATA_DIR=.paloma_data
PALOMA_CACHE_DIR=.paloma_data/cache

# Exports and movies are written only inside this folder; a destination folder entered in the app is relative to it.
#PALOMA_EXPORT_DIR=.paloma_data/export

# Photo folders to scan and watch on startup (comma-separated, absolute or relative).
# This is the only way to add folders; on startup, folders outside this list are removed
# from the library (files on disk are never touched).
PALOMA_PHOTOS_DIRS=

# Folders to skip while scanning, including their subfolders (comma-separated, absolute or relative).
# Already indexed photos in these folders are removed from the library on startup.
PALOMA_EXCLUDE_DIRS=

# Geocoding (address search and place names). The server sends search text and the centre of a
# ~1 km cell around each photo location to this Nominatim-compatible service, at most once a second.
# Leave unset for the public OpenStreetMap Nominatim; set to an empty value to turn geocoding off.
#PALOMA_GEOCODER_URL=https://nominatim.openstreetmap.org
# Contact e-mail or URL added to the User-Agent, as the Nominatim usage policy asks.
PALOMA_GEOCODER_CONTACT=

# Map tiles, loaded by the browser directly from this server ({z}/{x}/{y} placeholders), and their attribution.
#PALOMA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#PALOMA_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# External plugins: each direct subfolder with a paloma-plugin.json is a plugin, usually installed with
# `git clone <repo>` or `git submodule add <repo>` inside this folder. Defaults to plugins/ in PALOMA_DATA_DIR.
# External plugins run with full access to this computer and stay off until switched on in Plugins.
#PALOMA_PLUGINS_DIR=.paloma_data/plugins
